# Copy to .env locally; never commit the completed file.
YAHOO_CLIENT_ID=REPLACE_WITH_YOUR_CLIENT_ID
YAHOO_CLIENT_SECRET=REPLACE_WITH_YOUR_CLIENT_SECRET
# Register this EXACT URI with Yahoo first; use a loopback URI Yahoo accepts.
# This is separate from the public GitHub Pages app homepage.
YAHOO_REDIRECT_URI=https://localhost:8765/callback
